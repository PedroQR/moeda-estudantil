FROM node:22-alpine AS web
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json frontend/
WORKDIR /src/frontend
RUN npm ci
COPY frontend/ /src/frontend/
RUN npm run build

FROM maven:3.9.9-eclipse-temurin-21 AS api
WORKDIR /src
COPY pom.xml .
COPY src ./src
COPY --from=web /src/src/main/resources/static ./src/main/resources/static
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=api /src/target/moeda-estudantil-*.jar /app/app.jar
USER app
EXPOSE 80
ENTRYPOINT ["sh", "-c", "exec java -Dserver.port=${PORT:-80} -jar /app/app.jar"]
